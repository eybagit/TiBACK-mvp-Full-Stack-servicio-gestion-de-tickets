{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "buildCommand": "pipenv install --deploy --system && flask db upgrade"
    },
    "deploy": {
        "startCommand": "gunicorn wsgi:application --chdir ./src/ --bind 0.0.0.0:$PORT",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    }
}